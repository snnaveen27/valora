# ===================================================================
# VALORA AI PLATFORM - ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to .env and fill in your values

# ===================================================================
# EXTERNAL API KEYS (Map Providers & AI Services)
# ===================================================================
# Mapbox API (for basemap tiles) - Get from https://www.mapbox.com/
MAPBOX_API_KEY=your-mapbox-api-key-here

# OpenRouter API (for LLM services) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MODEL_REASONING=deepseek/deepseek-reasoner
OPENROUTER_MODEL_VISION=qwen/qwen2.5-vl-72b-instruct

# Pinecone Vector Database (optional) - Get from https://www.pinecone.io/
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX=valora-realestate

# HuggingFace API (optional) - Get from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ===================================================================
# BACKEND API CONFIGURATION
# ===================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

BACKEND_API_URL=http://127.0.0.1:8000
DMPE_API_URL=http://127.0.0.1:8000

# ===================================================================
# FRONTEND CONFIGURATION
# ===================================================================
PORT=3001
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Cesium Ion Token - Get from https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=your-cesium-ion-token-here

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:5173

# ===================================================================
# AUTHENTICATION (Optional)
# ===================================================================
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ===================================================================
# LOCAL LLM (Fallback/Offline Mode)
# ===================================================================
LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_LLM_MODEL=llama3.2

# ===================================================================
# DATABASE (SQLite by default, PostgreSQL for production)
# ===================================================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/valora

# ===================================================================
# PRODUCTION SETTINGS (Server Deployment)
# ===================================================================
# NODE_ENV=production
# For production, update VITE_API_URL to your server URL:
# VITE_API_URL=https://your-domain.com/api
