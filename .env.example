# =============================================================================
# VALORA AI - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE - Supabase (Cloud PostgreSQL)
# =============================================================================
# Get these from: https://app.supabase.com → Your Project → Settings → Database
# Use the "Connection string" with your password

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Direct connection (for migrations)
DATABASE_URL_DIRECT=postgresql://postgres.[PROJECT-REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API (optional - for Supabase JS client)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# API CONFIGURATION
# =============================================================================
VITE_API_URL=http://localhost:8000

# =============================================================================
# MAPPLS API (Maps)
# =============================================================================
# Get from: https://apis.mappls.com/console/
VITE_MAPPLS_API_KEY=your-mappls-api-key
MAPPLS_API_KEY=your-mappls-api-key

# =============================================================================
# OPENROUTER (LLM)
# =============================================================================
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# PINECONE (Vector DB - optional)
# =============================================================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX=valora-embeddings

# =============================================================================
# DEEPGRAM (Voice Transcription & TTS)
# =============================================================================
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key

# =============================================================================
# APIFY (Data Scraping)
# =============================================================================
# Get from: https://console.apify.com/
APIFY_API_TOKEN=your-apify-token

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Set to 'production' in production
NODE_ENV=development
PYTHON_ENV=development

# Enable/disable features
ENABLE_VOICE=true
ENABLE_ANALYTICS=true
ENABLE_SCRAPING=true
