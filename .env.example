# ===================================================================
# VALORA AI PLATFORM - ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to .env and fill in your values

# ===================================================================
# EXTERNAL API KEYS (Map Providers & AI Services)
# ===================================================================
# Mapbox API (for basemap tiles) - Get from https://www.mapbox.com/
MAPBOX_API_KEY=your-mapbox-api-key-here

# OpenRouter API (for LLM services) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MODEL_REASONING=deepseek/deepseek-reasoner
OPENROUTER_MODEL_VISION=qwen/qwen2.5-vl-72b-instruct

# Pinecone Vector Database (optional) - Get from https://www.pinecone.io/
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX=valora-realestate

# HuggingFace API (optional) - Get from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ===================================================================
# BACKEND API CONFIGURATION
# ===================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

BACKEND_API_URL=http://127.0.0.1:8000
DMPE_API_URL=http://127.0.0.1:8000

# ===================================================================
# FRONTEND CONFIGURATION
# ===================================================================
PORT=3001
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Cesium Ion Token - Get from https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=your-cesium-ion-token-here

# ===================================================================
# CESIUM ION ASSET IDs (Optional - enables premium features)
# ===================================================================
# Core assets
VITE_CESIUM_ION_TERRAIN_ASSET_ID=1
VITE_CESIUM_ION_PHOTOREALISTIC_ASSET_ID=2275207
VITE_CESIUM_ION_OSM_BUILDINGS_ASSET_ID=96188

# Local photorealistic tileset URL (for self-hosted tiles - education use)
# Set this to use locally cached tiles instead of streaming from Ion
# Example: VITE_LOCAL_PHOTOREALISTIC_TILESET_URL=/ion-cache/tileset.json
VITE_LOCAL_PHOTOREALISTIC_TILESET_URL=

# Bing Maps imagery
VITE_CESIUM_ION_BING_AERIAL_ASSET_ID=2
VITE_CESIUM_ION_BING_AERIAL_LABELS_ASSET_ID=3
VITE_CESIUM_ION_BING_ROAD_ASSET_ID=4

# Google Maps imagery
VITE_CESIUM_ION_GOOGLE_SATELLITE_ASSET_ID=3830182
VITE_CESIUM_ION_GOOGLE_SATELLITE_LABELS_ASSET_ID=3830183
VITE_CESIUM_ION_GOOGLE_ROADMAP_ASSET_ID=3830184
VITE_CESIUM_ION_GOOGLE_LABELS_ASSET_ID=3830185
VITE_CESIUM_ION_GOOGLE_CONTOUR_ASSET_ID=3830186

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:5173

# ===================================================================
# AUTHENTICATION (Required — sessions break without this)
# ===================================================================
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ===================================================================
# LOCAL LLM (Fallback/Offline Mode)
# ===================================================================
LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_LLM_MODEL=valora-ai-mini:latest

# ===================================================================
# DATABASE (SQLite by default, PostgreSQL for production)
# ===================================================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/valora

# ===================================================================
# PRODUCTION SETTINGS (Server Deployment)
# ===================================================================
# NODE_ENV=production
# For production (Nginx proxy), use the app base path:
# VITE_API_URL=/valora
