# Production Environment Variables for Valora AI
# Copy this to .env and update with actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/valora

# LLM Configuration (OpenRouter - Default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_LLM_MODEL=deepseek/deepseek-chat
REASONING_MODEL=deepseek/deepseek-reasoner
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# File Paths
OSM_DATA_DIR=./src/data/osm_extracted
TERRAIN_DIR=./src/data/terrain
PROPERTIES_DIR=./src/data/posted_properties

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "https://3.109.34.1.sslip.io"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=INFO
