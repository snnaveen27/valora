# ===================================================================
# UNIFIED ENVIRONMENT CONFIGURATION - Valora AI Platform
# ===================================================================
# This single .env file contains all configuration for:
# - Apache Airflow (ETL Orchestration)
# - Backend API (FastAPI)
# - External APIs (Mappls, OpenRouter, Pinecone)
# - Apify Integration (Managed Scraping)
# - Database & Services
# ===================================================================

# ===================================================================
# AIRFLOW CONFIGURATION
# ===================================================================
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin123
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__SCHEDULER__DAG_DIR_SCAN_INTERVAL=30

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# PostgreSQL (Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Database
DATABASE_URL=sqlite:///./dmpe.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valora_ai
DB_USER=valora_user
DB_PASSWORD=valora_password

# ===================================================================
# APIFY CONFIGURATION (RECOMMENDED for production)
# ===================================================================
# Get your token from: https://console.apify.com/account/integrations
# Free tier: 5 USD credit/month (enough for testing)
# Pro tier: Starting at 49 USD/month (for production)
APIFY_API_TOKEN=apify_api_c8LKHv6uMSri0QmrOfQ0NfIf1ItKA21xoE8D
APIFY_PROXY_GROUPS=RESIDENTIAL,DATACENTER
APIFY_MEMORY_MB=8192
APIFY_TIMEOUT_SEC=3600
APIFY_MAX_RETRIES=5
APIFY_RETRY_DELAY_SEC=30
APIFY_ACTOR_DEFAULT_TIMEOUT=7200
# ===================================================================
# EXTERNAL API KEYS
# ===================================================================
# OpenRouter API (for LLM services)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL_REASONING=mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL_VISION=allenai/molmo-7b-d-0924:free
# Mapbox API (for basemap tiles)
# Pinecone Vector Database (for embeddings)
PINECONE_API_KEY=pcsk_7SC4c3_L2LUVEAgqYywYEjUv1zGY5CrThd2JRtDJTP2YG8FdkUEpRCnHA2fvbbBrYDd2VT
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX=valora-realestate

# HuggingFace API (for ML models)
HUGGINGFACE_API_KEY=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

# ===================================================================
# BACKEND API CONFIGURATION
# ===================================================================
# Backend API URL (used by Airflow to trigger retraining)
BACKEND_API_URL=http://host.docker.internal:8000
DMPE_API_URL=http://127.0.0.1:8000

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Frontend Configuration
PORT=3001
VITE_BACKEND_URL=http://127.0.0.1:8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:5173,http://localhost:3003,http://127.0.0.1:3003

# ===================================================================
# SCRAPING CONFIGURATION
# ===================================================================
# General scraping settings
SCRAPING_DELAY=2
MAX_RETRIES=3
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Rate limiting
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_DELAY=1

# Cities to scrape
SCRAPING_CITIES=Bangalore,Mumbai,Delhi,Pune,Hyderabad,Chennai

# Property types
PROPERTY_TYPES=apartment,house,villa,studio

# ===================================================================
# DATA QUALITY THRESHOLDS
# ===================================================================
# Price validation (in INR)
MIN_PRICE=1000000
MAX_PRICE=500000000

# Area validation (in sqft)
MIN_AREA=100
MAX_AREA=50000

# Bedroom validation
MIN_BEDROOMS=1
MAX_BEDROOMS=10

# Geographic bounds for India
MIN_LATITUDE=6.0
MAX_LATITUDE=37.0
MIN_LONGITUDE=68.0
MAX_LONGITUDE=97.0

# ===================================================================
# MODEL RETRAINING CONFIGURATION
# ===================================================================
# Trigger retraining when new data reaches threshold
MIN_NEW_RECORDS=500
RETRAINING_INTERVAL_DAYS=7

# Model performance thresholds
MIN_R2_SCORE=0.70
MAX_MAE_PERCENTAGE=15.0
MIN_IMPROVEMENT_THRESHOLD=0.02
MAX_DEGRADATION_THRESHOLD=0.05

# Model storage
MODELS_DIR=data/models
BACKUP_MODELS_COUNT=5

# ===================================================================
# SCHEDULER CONFIGURATION
# ===================================================================
# APScheduler for model retraining
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_CRON=0 2 * * 0  # Every Sunday at 2 AM IST

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================
# Log levels
LOG_LEVEL=INFO
AIRFLOW_LOG_LEVEL=INFO
BACKEND_LOG_LEVEL=INFO
DEBUG=False

# Log file paths
LOG_DIR=logs
AIRFLOW_LOG_DIR=logs/airflow
BACKEND_LOG_DIR=logs/backend
LOG_FILE=logs/dmpe.log

# ===================================================================
# MONITORING & ALERTS
# ===================================================================
# Email notifications (for failures)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@valora.ai

# Slack notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ===================================================================
# SECURITY CONFIGURATION
# ===================================================================
# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Encryption
ENCRYPTION_KEY=your_encryption_key_here

# ===================================================================
# DEVELOPMENT CONFIGURATION
# ===================================================================
# Environment
NODE_ENV=production
PYTHON_ENV=production

# Debug settings
VERBOSE=false

# ===================================================================
# DOCKER CONFIGURATION
# ===================================================================
# Docker compose settings
COMPOSE_PROJECT_NAME=valora_ai
COMPOSE_FILE=docker-compose.yml

# Container ports
AIRFLOW_WEB_PORT=8080
AIRFLOW_SCHEDULER_PORT=8793
BACKEND_API_PORT=8000
FRONTEND_PORT=3000

# ===================================================================
# PERFORMANCE TUNING
# ===================================================================
# Airflow performance
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__DAG_CONCURRENCY=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=8

# Backend performance
WORKER_PROCESSES=4
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30

# ===================================================================
# FEATURE FLAGS
# ===================================================================
# Enable/disable features
ENABLE_APIFY=true
ENABLE_CUSTOM_SCRAPERS=true
ENABLE_AUTO_RETRAINING=true
ENABLE_MARKET_ENRICHMENT=true
ENABLE_MULTI_AGENT=true

# ===================================================================
# BACKUP CONFIGURATION
# ===================================================================
# Database backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM
BACKUP_RETENTION_DAYS=30

# Model backup
MODEL_BACKUP_ENABLED=true
MODEL_BACKUP_SCHEDULE=0 4 * * 0  # Weekly on Sunday at 4 AM

# ===================================================================
# TESTING CONFIGURATION
# ===================================================================
# Test database
TEST_DB_NAME=valora_ai_test
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password

# Test API keys (can be dummy for testing)
TEST_APIFY_TOKEN=test_token
# TEST_MAPPLS_KEY=test_key

# ===================================================================
# MIGRATION CONFIGURATION
# ===================================================================
# Database migration settings
MIGRATION_ENABLED=true
MIGRATION_AUTO_APPLY=false
MIGRATION_TIMEOUT=300

# ===================================================================
# CACHING CONFIGURATION
# ===================================================================
# Redis cache (if used)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL (in seconds)
CACHE_TTL=3600
PROPERTY_CACHE_TTL=86400
POI_CACHE_TTL=604800

# ===================================================================
# PATHS
# ===================================================================
# Data paths
DATA_DIR=data
FEATURE_STORE_PATH=data/feature_store
MODEL_PATH=data/models/price_model.pkl

# ===================================================================
# NOTES
# ===================================================================
# 1. Replace all 'your_*_key_here' with actual values
# 2. For production, use strong passwords and secret keys
# 3. Store this file securely and add to .gitignore
# 4. Update APIFY_API_TOKEN to enable managed scraping
# 5. Configure SMTP for email alerts on failures
# 6. Set up proper CORS origins for your domain
# ===================================================================
VITE_API_URL=http://localhost:8000


STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
CASHFREE_APP_ID=xxx
CASHFREE_SECRET_KEY=xxx
CASHFREE_ENV=PROD