{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Valora AI Spatial Tools - Offline Internal Tool Definitions for LLM-directed calling",
  "tools": [
    {
      "name": "get_3d_context",
      "description": "Analyze complete 3D spatial context at a location and floor height. Returns neighbor buildings, volumetric data, sky view, view quality, and skyline character.",
      "category": "3d_spatial",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Latitude coordinate"},
          "lng": {"type": "number", "description": "Longitude coordinate"},
          "floor_height_m": {"type": "number", "default": 0, "description": "Height above ground in meters (floor * 3m)"},
          "radius_m": {"type": "number", "default": 200, "description": "Analysis radius in meters"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "Spatial3DAnalysis",
        "fields": ["buildings_above", "buildings_below", "sky_view_factor", "open_directions", "view_quality", "skyline_character", "reasoning"]
      }
    },
    {
      "name": "analyze_viewshed",
      "description": "Cast rays in 8 cardinal directions to analyze what can be seen from a location and floor. Returns openness score, best/worst view directions, and visible landmarks.",
      "category": "3d_spatial",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Latitude coordinate"},
          "lng": {"type": "number", "description": "Longitude coordinate"},
          "floor": {"type": "integer", "default": 1, "description": "Floor number (1-indexed)"},
          "building_height_m": {"type": "number", "description": "Total building height (optional)"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "ViewshedResult",
        "fields": ["rays", "sky_view_factor", "openness_score", "best_view_direction", "worst_view_direction", "visible_landmarks", "view_description"]
      }
    },
    {
      "name": "compare_floors",
      "description": "Compare view quality and 3D context across multiple floors at a building location. Helps find optimal floor for views.",
      "category": "3d_spatial",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Latitude coordinate"},
          "lng": {"type": "number", "description": "Longitude coordinate"},
          "floors": {"type": "array", "items": {"type": "integer"}, "default": [1, 5, 10, 15], "description": "Floor numbers to compare"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "FloorComparison",
        "fields": ["floors_compared", "best_value_floor", "recommendation"]
      }
    },
    {
      "name": "get_shadow_impact",
      "description": "Analyze shadow impact at a location for a specific hour. Returns shadow sources and impact level.",
      "category": "3d_spatial",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Latitude coordinate"},
          "lng": {"type": "number", "description": "Longitude coordinate"},
          "hour": {"type": "integer", "default": 10, "minimum": 6, "maximum": 18, "description": "Hour of day (6-18)"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "ShadowAnalysis",
        "fields": ["hour", "shadow_direction", "sun_angle", "impact", "shadow_sources", "recommendation"]
      }
    },
    {
      "name": "find_best_floor",
      "description": "Find the optimal floor for views at a location, balancing view quality with accessibility.",
      "category": "3d_spatial",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Latitude coordinate"},
          "lng": {"type": "number", "description": "Longitude coordinate"},
          "max_floor": {"type": "integer", "default": 20, "description": "Maximum floor to consider"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "FloorRecommendation",
        "fields": ["recommended_floor", "height_m", "view_quality", "score", "reasoning"]
      }
    },
    {
      "name": "analyze_building",
      "description": "Perform comprehensive 3D analysis of a building including shadow impact, view obstruction, neighbors, and accessibility.",
      "category": "3d_spatial",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Building latitude"},
          "lng": {"type": "number", "description": "Building longitude"},
          "height_m": {"type": "number", "description": "Building height in meters (optional, will lookup)"},
          "building_type": {"type": "string", "description": "Type of building (residential, commercial, etc.)"},
          "building_id": {"type": "string", "description": "OSM ID or identifier"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "Building3DAnalysis",
        "fields": ["height_m", "floors", "shadow_impact_score", "view_obstruction_score", "view_quality", "taller_neighbors", "shorter_neighbors", "eye_level_neighbors", "viewshed_result"]
      }
    },
    {
      "name": "search_properties",
      "description": "Search real estate properties with spatial and attribute filters. Supports listing type, category, BHK, price range, and text search.",
      "category": "real_estate",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Center latitude for spatial search"},
          "lng": {"type": "number", "description": "Center longitude for spatial search"},
          "radius_m": {"type": "integer", "default": 2000, "description": "Search radius in meters"},
          "listing_type": {"type": "string", "enum": ["sale", "rent"], "description": "Sale or rent"},
          "property_category": {"type": "string", "enum": ["residential", "commercial", "plot", "pg"], "description": "Property category"},
          "property_subtype": {"type": "string", "enum": ["flat", "villa", "penthouse", "studio", "office", "shop", "warehouse"], "description": "Property subtype"},
          "pg_type": {"type": "string", "enum": ["boys", "girls", "coed"], "description": "PG type (for PG listings)"},
          "bhk": {"type": "string", "enum": ["1BHK", "2BHK", "3BHK", "4BHK+"], "description": "BHK configuration"},
          "min_price": {"type": "integer", "description": "Minimum price"},
          "max_price": {"type": "integer", "description": "Maximum price"},
          "locality": {"type": "string", "description": "Locality name filter"},
          "text_query": {"type": "string", "description": "Full-text search query"},
          "limit": {"type": "integer", "default": 50, "description": "Maximum results"}
        },
        "required": []
      },
      "returns": {
        "type": "PropertyList",
        "fields": ["properties", "count", "filters_applied"]
      }
    },
    {
      "name": "get_locality_profile",
      "description": "Get precomputed intelligence profile for a locality including demographics, growth phase, risk indexes, and market trends.",
      "category": "real_estate",
      "parameters": {
        "type": "object",
        "properties": {
          "locality_name": {"type": "string", "description": "Name of the locality"},
          "city_id": {"type": "string", "default": "BLR", "description": "City identifier"}
        },
        "required": ["locality_name"]
      },
      "returns": {
        "type": "LocalityState",
        "fields": ["locality_name", "growth_phase", "median_price", "price_trend", "supply_demand", "risk_score", "livability_score", "investment_score"]
      }
    },
    {
      "name": "get_nearby_locality",
      "description": "Find the nearest locality to given coordinates.",
      "category": "real_estate",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Latitude coordinate"},
          "lng": {"type": "number", "description": "Longitude coordinate"},
          "radius_km": {"type": "number", "default": 2.0, "description": "Search radius in km"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "LocalityState",
        "fields": ["locality_name", "distance_km", "center_lat", "center_lng"]
      }
    },
    {
      "name": "simulate_infrastructure",
      "description": "Simulate impact of adding new infrastructure (metro, highway, IT park, etc.) at a location using causal graphs.",
      "category": "simulation",
      "parameters": {
        "type": "object",
        "properties": {
          "infrastructure_type": {"type": "string", "enum": ["metro_station", "highway", "it_park", "mall", "hospital", "school", "park"], "description": "Type of infrastructure"},
          "lat": {"type": "number", "description": "Latitude of new infrastructure"},
          "lng": {"type": "number", "description": "Longitude of new infrastructure"},
          "name": {"type": "string", "description": "Name of the infrastructure"},
          "radius_m": {"type": "number", "default": 2000, "description": "Impact radius in meters"}
        },
        "required": ["infrastructure_type", "lat", "lng"]
      },
      "returns": {
        "type": "SimulationResult",
        "fields": ["impacts", "affected_properties", "affected_localities", "timeline", "confidence"]
      }
    },
    {
      "name": "estimate_valuation",
      "description": "Estimate property valuation based on location, configuration, and market comparables.",
      "category": "real_estate",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Property latitude"},
          "lng": {"type": "number", "description": "Property longitude"},
          "property_type": {"type": "string", "enum": ["flat", "villa", "plot", "commercial"], "description": "Property type"},
          "bhk": {"type": "string", "description": "BHK configuration"},
          "area_sqft": {"type": "number", "description": "Built-up area in sqft"},
          "floor": {"type": "integer", "description": "Floor number"},
          "age_years": {"type": "integer", "description": "Age of property in years"}
        },
        "required": ["lat", "lng", "property_type", "area_sqft"]
      },
      "returns": {
        "type": "ValuationResult",
        "fields": ["estimated_value", "price_per_sqft", "confidence", "comparables_used", "factors"]
      }
    },
    {
      "name": "geocode",
      "description": "Convert a location name/address to coordinates using local data.",
      "category": "utility",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Location name or address to geocode"}
        },
        "required": ["query"]
      },
      "returns": {
        "type": "GeocodingResult",
        "fields": ["lat", "lng", "display_name", "locality", "confidence"]
      }
    },
    {
      "name": "get_pois_nearby",
      "description": "Get points of interest near a location filtered by category.",
      "category": "utility",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Center latitude"},
          "lng": {"type": "number", "description": "Center longitude"},
          "radius_m": {"type": "integer", "default": 1000, "description": "Search radius in meters"},
          "category": {"type": "string", "enum": ["restaurant", "hospital", "school", "park", "metro", "bus", "atm", "bank", "grocery", "mall"], "description": "POI category filter"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "POIList",
        "fields": ["pois", "count", "categories"]
      }
    },
    {
      "name": "ui_command",
      "description": "Send a command to control the frontend UI (fly to location, open panel, switch tab, etc.).",
      "category": "ui",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {"type": "string", "enum": ["flyTo", "openPanel", "closePanel", "switchTab", "highlightBuilding", "drawRadius", "setCinemaMode"], "description": "UI action to perform"},
          "payload": {"type": "object", "description": "Action-specific payload (lat, lng, zoom, panel_name, tab_name, etc.)"}
        },
        "required": ["action"]
      },
      "returns": {
        "type": "UICommandResult",
        "fields": ["success", "action_performed"]
      }
    },
    {
      "name": "find_view_blockers",
      "description": "Find buildings that block view from a location in given direction(s). Uses true line-of-sight calculation.",
      "category": "occlusion",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Observer latitude"},
          "lng": {"type": "number", "description": "Observer longitude"},
          "floor_height_m": {"type": "number", "description": "Observer height above ground"},
          "direction": {"type": "string", "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"], "description": "Direction to check (optional, checks all if omitted)"},
          "radius_m": {"type": "number", "default": 300, "description": "Search radius"}
        },
        "required": ["lat", "lng", "floor_height_m"]
      },
      "returns": {
        "type": "BlockerList",
        "fields": ["blockers", "direction", "severity"]
      }
    },
    {
      "name": "check_line_of_sight",
      "description": "Check if there is clear line of sight between two 3D points. Returns blockers if obstructed.",
      "category": "occlusion",
      "parameters": {
        "type": "object",
        "properties": {
          "from_lat": {"type": "number", "description": "Observer latitude"},
          "from_lng": {"type": "number", "description": "Observer longitude"},
          "from_height": {"type": "number", "description": "Observer height"},
          "to_lat": {"type": "number", "description": "Target latitude"},
          "to_lng": {"type": "number", "description": "Target longitude"},
          "to_height": {"type": "number", "default": 0, "description": "Target height"}
        },
        "required": ["from_lat", "from_lng", "from_height", "to_lat", "to_lng"]
      },
      "returns": {
        "type": "LineOfSightResult",
        "fields": ["clear", "blockers", "visibility_score"]
      }
    },
    {
      "name": "get_360_visibility",
      "description": "Get 360-degree visibility analysis from a location. Checks all 8 cardinal directions.",
      "category": "occlusion",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Location latitude"},
          "lng": {"type": "number", "description": "Location longitude"},
          "floor": {"type": "integer", "default": 1, "description": "Floor number"},
          "radius_m": {"type": "number", "default": 500, "description": "View distance"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "VisibilityResult",
        "fields": ["directions", "open_directions", "blocked_directions", "view_quality", "openness_score"]
      }
    },
    {
      "name": "can_see_landmark",
      "description": "Check if a specific landmark can be seen from a location and floor.",
      "category": "occlusion",
      "parameters": {
        "type": "object",
        "properties": {
          "from_lat": {"type": "number", "description": "Observer latitude"},
          "from_lng": {"type": "number", "description": "Observer longitude"},
          "from_floor": {"type": "integer", "description": "Observer floor"},
          "landmark_name": {"type": "string", "description": "Name of landmark to check visibility for"}
        },
        "required": ["from_lat", "from_lng", "from_floor", "landmark_name"]
      },
      "returns": {
        "type": "LandmarkVisibility",
        "fields": ["found", "can_see", "visibility_percent", "blockers", "best_floor", "reasoning"]
      }
    },
    {
      "name": "analyze_sunlight",
      "description": "Comprehensive sunlight analysis for a location and floor. Includes sunrise/sunset, shadow timeline, and natural light score.",
      "category": "solar",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Location latitude"},
          "lng": {"type": "number", "description": "Location longitude"},
          "floor": {"type": "integer", "default": 1, "description": "Floor number"},
          "date": {"type": "string", "description": "Date in YYYY-MM-DD format (optional, defaults to today)"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "SunlightAnalysis",
        "fields": ["sunrise", "sunset", "daylight_hours", "shadow_timeline", "natural_light_score", "morning_sun_quality", "evening_sun_quality", "summary"]
      }
    },
    {
      "name": "get_shadow_timeline",
      "description": "Get shadow impact timeline throughout the day at a location.",
      "category": "solar",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Location latitude"},
          "lng": {"type": "number", "description": "Location longitude"},
          "date": {"type": "string", "description": "Date in YYYY-MM-DD format"},
          "hours": {"type": "array", "items": {"type": "integer"}, "default": [6, 8, 10, 12, 14, 16, 18], "description": "Hours to analyze"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "ShadowTimeline",
        "fields": ["timeline", "worst_hour", "best_hour"]
      }
    },
    {
      "name": "compare_seasons",
      "description": "Compare sunlight across seasons (winter vs summer) at a location.",
      "category": "solar",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Location latitude"},
          "lng": {"type": "number", "description": "Location longitude"},
          "floor": {"type": "integer", "default": 1, "description": "Floor number"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "SeasonComparison",
        "fields": ["summer", "winter", "equinox", "recommendation"]
      }
    },
    {
      "name": "get_facade_sunlight",
      "description": "Get sunlight hours by facade direction (N/E/S/W). Helps choose room orientation.",
      "category": "solar",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Building latitude"},
          "lng": {"type": "number", "description": "Building longitude"},
          "floor": {"type": "integer", "default": 1, "description": "Floor number"},
          "date": {"type": "string", "description": "Date in YYYY-MM-DD format"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "FacadeSunlight",
        "fields": ["facades", "best_facade", "recommendation"]
      }
    },
    {
      "name": "query_spatial_relations",
      "description": "Query precomputed spatial relationships between buildings (blocks_view, adjacent_to, taller_than, near_landmark).",
      "category": "spatial_graph",
      "parameters": {
        "type": "object",
        "properties": {
          "relation_type": {"type": "string", "enum": ["blocks_view", "shadows", "overlooks", "adjacent_to", "within_walk", "taller_than", "near_landmark"], "description": "Type of relationship"},
          "source_id": {"type": "string", "description": "Source entity ID"},
          "target_id": {"type": "string", "description": "Target entity ID"},
          "direction": {"type": "string", "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"], "description": "Direction filter"},
          "max_distance_m": {"type": "number", "description": "Maximum distance filter"},
          "limit": {"type": "integer", "default": 100, "description": "Maximum results"}
        },
        "required": []
      },
      "returns": {
        "type": "RelationList",
        "fields": ["relations", "count"]
      }
    },
    {
      "name": "find_buildings_behind",
      "description": "Find buildings 'behind' a reference point from a viewpoint. Useful for queries like 'buildings behind the mall'.",
      "category": "spatial_graph",
      "parameters": {
        "type": "object",
        "properties": {
          "reference_lat": {"type": "number", "description": "Reference point latitude (e.g., mall location)"},
          "reference_lng": {"type": "number", "description": "Reference point longitude"},
          "viewpoint_lat": {"type": "number", "description": "Viewpoint latitude"},
          "viewpoint_lng": {"type": "number", "description": "Viewpoint longitude"},
          "radius_m": {"type": "number", "default": 500, "description": "Search radius from reference"}
        },
        "required": ["reference_lat", "reference_lng", "viewpoint_lat", "viewpoint_lng"]
      },
      "returns": {
        "type": "BuildingList",
        "fields": ["buildings", "count"]
      }
    },
    {
      "name": "find_overlooks",
      "description": "Find what landmarks a tall building can overlook within a radius.",
      "category": "spatial_graph",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {"type": "number", "description": "Building latitude"},
          "lng": {"type": "number", "description": "Building longitude"},
          "min_height": {"type": "number", "default": 30, "description": "Minimum building height to consider"},
          "radius_m": {"type": "number", "default": 2000, "description": "View radius"}
        },
        "required": ["lat", "lng"]
      },
      "returns": {
        "type": "OverlooksList",
        "fields": ["landmarks", "count"]
      }
    }
  ],
  "constraints": {
    "offline_only": true,
    "grounded_facts_only": true,
    "max_tools_per_turn": 5,
    "timeout_seconds": 30
  }
}
