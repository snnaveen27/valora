# =============================================================================
# VALORA AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# LLM Configuration (OpenRouter - Recommended for Production)
# -----------------------------------------------------------------------------
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Primary model: DeepSeek V3.2 (671B) - Best value, GPT-4 level performance
OPENROUTER_MODEL=deepseek/deepseek-chat

# Reasoning model: For simulations and complex analysis
OPENROUTER_MODEL_REASONING=deepseek/deepseek-reasoner

# Vision model: For property image analysis
OPENROUTER_MODEL_VISION=qwen/qwen2.5-vl-72b-instruct

# -----------------------------------------------------------------------------
# Local LLM (Fallback/Offline Mode)
# -----------------------------------------------------------------------------
# URL for local llama.cpp or Ollama server
LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions

# Local model name (if using Ollama)
LOCAL_LLM_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valora

# -----------------------------------------------------------------------------
# Nominatim (Local Geocoding)
# -----------------------------------------------------------------------------
NOMINATIM_URL=http://localhost:8088

# -----------------------------------------------------------------------------
# Vector Search (Optional)
# -----------------------------------------------------------------------------
# Pinecone for cloud vector search (optional, FAISS used by default)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=valora-properties

# -----------------------------------------------------------------------------
# Mapbox (Optional - for additional map features)
# -----------------------------------------------------------------------------
MAPBOX_API_KEY=

# -----------------------------------------------------------------------------
# Cesium (3D Visualization)
# -----------------------------------------------------------------------------
# Get token from https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=your-cesium-ion-token

# -----------------------------------------------------------------------------
# Authentication (Optional)
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
