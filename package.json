{
  "name": "valora-ai",
  "version": "2025.2.5",
  "type": "module",
  "description": "Valora AI - 3D Reasoning AI GIS Platform for Real Estate",
  "scripts": {
    "dev": "concurrently -k -s first -n backend,frontend \"python scripts/start_dev.py\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "python -c \"import uvicorn, fastapi\" && python -m uvicorn server:app --app-dir backend --port 8000 --reload",
    "start:all": "concurrently -k -s first -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "@loaders.gl/3d-tiles": "^4.3.4",
    "@loaders.gl/core": "^4.3.4",
    "@react-three/drei": "^9.92.0",
    "@react-three/fiber": "^8.15.12",
    "@tailwindcss/typography": "^0.5.16",
    "axios": "^1.6.2",
    "cesium": "^1.137.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lucide-react": "^0.294.0",
    "openai": "^4.20.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.0",
    "resium": "^1.19.2",
    "sirv": "^3.0.2",
    "three": "^0.160.0",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "vite": "^7.2.2",
    "vite-plugin-compression": "^0.5.1"
  }
}
